# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django Admin — outil de debug interne uniquement (jamais le produit).
# Laisser DJANGO_ADMIN_ENABLED=False en production ; DJANGO_ADMIN_URL doit
# être un chemin non devinable si jamais activé ponctuellement.
DJANGO_ADMIN_ENABLED=False
DJANGO_ADMIN_URL=admin/

# CORS (origines autorisées à appeler l'API, séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5000
# CSRF (nécessaire seulement si l'admin Django est exposé en HTTPS)
CSRF_TRUSTED_ORIGINS=

# Base de données PostgreSQL — en production (Render/Railway), DATABASE_URL
# (fournie automatiquement par la base managée) prend le pas sur les
# variables séparées ci-dessous, qui restent utilisées en local.
DATABASE_URL=
DB_NAME=bailconnect
DB_USER=bailconnect
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# OTP SMS — provider: console (dev) ou twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Email OTP — provider: console (dev) ou smtp
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=Bailconnect <no-reply@bailconnect.cm>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Stockage média — backend: local (dev) ou s3 (Cloudflare R2 / AWS S3)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Domaine public servant les médias (ex. bucket.r2.dev, ou domaine custom
# connecté au bucket) — laisser vide pour utiliser l'URL de AWS_S3_ENDPOINT_URL.
AWS_S3_CUSTOM_DOMAIN=

# URL du frontend (utilisée pour construire les liens d'invitation)
FRONTEND_URL=http://localhost:5000

# Fraîcheur des annonces : jours sans confirmation avant expiration auto
LISTING_EXPIRY_DAYS=7
