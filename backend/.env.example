# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origines autorisées à appeler l'API, séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Base de données PostgreSQL
DB_NAME=bailconnect
DB_USER=bailconnect
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# OTP SMS — provider: console (dev) ou twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Stockage média — backend: local (dev) ou s3 (Cloudflare R2 / AWS S3)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# URL du frontend (utilisée pour construire les liens d'invitation)
FRONTEND_URL=http://localhost:5000
